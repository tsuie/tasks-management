# JetBrains/VSCode REST Client requests for Tasks module
# Set variables
@baseUrl = http://localhost:3000
@contentType = application/json
@taskId = 3

### Create task
#POST {{baseUrl}}/tasks
#Content-Type: {{contentType}}
#
#{
#  "title": "Write docs",
#  "description": "Draft API documentation",
#  "status": "pending"
#}

### List tasks (basic)
GET {{baseUrl}}/tasks

### List tasks with pagination, filter, sort, search
GET {{baseUrl}}/tasks?page=1&limit=10&status=pending&priority=medium&sortBy=dueDate&sortOrder=asc&search=docs

### Get task by id
GET {{baseUrl}}/tasks/{{taskId}}

### Update task (partial)
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}

{
  "title": "Write docs updated",
  "status": "in_progress"
}

### Delete task
#DELETE {{baseUrl}}/tasks/{{taskId}}
